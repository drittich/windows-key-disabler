<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>windows-key-disabler</AssemblyName>
    <RootNamespace>WindowsKeyDisabler</RootNamespace>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.20" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.20" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\WindowsKeyDisabler\enabled.ico" Link="enabled.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\WindowsKeyDisabler\disabled.ico" Link="disabled.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
